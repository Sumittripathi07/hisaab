# Copy to .env and fill in. Real secrets are never committed.
DATABASE_URL=postgresql://hisaab:hisaab@localhost:5432/hisaab
TEST_DATABASE_URL=postgresql://hisaab:hisaab@localhost:5432/hisaab_test
# Outgoing email. `file://<dir>` writes each email as a JSON file instead of sending it
# (a relative dir resolves against the working directory). Production uses smtps://user:pass@host:465.
SMTP_URL=file://./.dev-outbox
# EMAIL_FROM="Hisaab <no-reply@hisaab.local>"

# Better Auth. The secret signs sessions and tokens: generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The public origin of the app. Magic links and the Google redirect URI are built from it.
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (Cloud Console > APIs & Services > Credentials). Authorised redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
